# Copy this file to .env and fill in real values. Never commit .env itself.

# Required for any SEC EDGAR call. SEC asks for a descriptive User-Agent
# identifying the requester; a bare "python-requests" style agent gets
# throttled or blocked. See https://www.sec.gov/edgar/sec-api-documentation
SEC_USER_AGENT="Your Name your-email@example.com"

# Optional. Only needed for the Tiingo delisted-ticker price backfill
# (Section 4 of the build guide). Free tier: register at https://www.tiingo.com/
# and paste the API key below. Free tier is capped at 500 unique symbols/month,
# 50 requests/hour, 1,000 requests/day.
TIINGO_API_KEY=
